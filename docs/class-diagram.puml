@startuml Smart Band Edge Service - Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false

package "Health Bounded Context" #DEEAFF {
  package "domain" #E2F0FF {
    class HealthRecord {
      +submitting_device: SubmittingDevice
      +event_id: TelemetryEventId
      +heart_rate: HeartRateBpm
      +recorded_at: RecordedAt
      +timestamp_supplied: bool
      +id: int | None
      +record(submitting_device, event_id, bpm, created_at): HealthRecord
      +reconstitute(submitting_device, event_id, bpm, created_at, timestamp_supplied, record_id): HealthRecord
      +with_persistence_id(record_id): HealthRecord
      +device_id: str
      +bpm: float
      +created_at: datetime
    }

    class SubmittingDevice {
      +device_id: str
    }

    class HeartRateBpm {
      +value: float
    }

    class RecordedAt {
      +value: datetime
      +now(): RecordedAt
      +from_optional(value): RecordedAt
    }

    class TelemetryEventId {
      +value: str
    }

    class TelemetryEventConflict

    interface "HealthRecordRepository\n<<Protocol>>" as IHealthRecordRepository {
      +save_idempotently(health_record): HealthRecordSaveResult
    }

    class HealthRecordSaveResult {
      +record: HealthRecord
      +created: bool
    }
  }

  package "application" #D5E7FF {
    class HealthRecordApplicationService {
      +__init__(iam_anti_corruption_layer, health_record_repository=None)
      +create_health_record(device_id, event_id, bpm, created_at, api_key): HealthRecordSaveResult
    }
    class DeviceAuthenticationFailed
  }

  package "integration" #DCE8F5 {
    class IamAntiCorruptionLayer {
      +authenticated_submitting_device(device_id, credential): SubmittingDevice | None
    }
  }

  package "infrastructure" #C9DFFF {
    class HealthRecordModel <<Peewee Model>> {
      +id: AutoField
      +device_id: CharField
      +event_id: CharField | None
      +bpm: FloatField
      +created_at: DateTimeField
      +timestamp_supplied: BooleanField
    }

    class "HealthRecordRepository\n(implementation)" as HealthRecordRepositoryImpl {
      +migrate_schema()
      +save_idempotently(health_record): HealthRecordSaveResult
    }
  }

  package "interfaces" #BCCEFF {
    class HealthRecordCreateRequest <<Pydantic Model>> {
      +device_id: str
      +event_id: str
      +bpm: float
      +created_at: datetime | None
    }

    class health_api <<Flask Blueprint>> {
      +create_health_record(): tuple
      +POST /api/v1/health-monitoring/data-records
    }
  }
}

package "IAM Bounded Context" #FFEBDE {
  package "domain" #FFF2E8 {
    class Device {
      +device_id: str
      +credential: ApiCredential
      +created_at: datetime
      +revoked_at: datetime | None
      +register(device_id, api_key, created_at=None): Device
      +authenticate(api_key): bool
      +revoke(at=None): Device
      +rotate_api_key(new_api_key): Device
    }

    class ApiCredential {
      +create(secret): ApiCredential
      +from_encoded(encoded): ApiCredential
      +matches(secret): bool
      +encode(): str
    }

    interface "DeviceRepository\n<<Protocol>>" as IDeviceRepository {
      +find_by_device_id(device_id): Device | None
      +save(device): Device
      +get_or_create_test_device(device_id, api_key): Device
    }
  }

  package "application" #FFE6D5 {
    class AuthApplicationService {
      +__init__(device_repository=None)
      +authenticate(device_id, api_key): bool
      +register_device(device_id, api_key): Device
      +rotate_api_key(device_id, new_api_key): Device
      +revoke_device(device_id): Device
      +get_or_create_test_device(device_id, api_key): Device
    }
  }

  package "infrastructure" #FFDAC1 {
    class DeviceModel <<Peewee Model>> {
      +device_id: CharField
      +credential_verifier: CharField
      +created_at: DateTimeField
      +revoked_at: DateTimeField | None
    }

    class "DeviceRepository\n(implementation)" as DeviceRepositoryImpl {
      +migrate_schema()
      +find_by_device_id(device_id): Device | None
      +save(device): Device
      +get_or_create_test_device(device_id, api_key): Device
    }
  }

  package "interfaces" #FFCEAE {
    class AuthRequest <<Pydantic Model>> {
      +device_id: str
    }

    class iam_api <<Flask Blueprint>> {
      +authenticate_device(): tuple
      +POST /api/v1/iam/authentications
    }
  }
}

package "Shared Infrastructure" #E8FFE8 {
  class db <<SqliteDatabase>>
  class configure_database {
    +configure_database(database_path)
  }
  class init_db {
    +init_db()
  }
}

class create_app {
  +create_app(): Flask
}

